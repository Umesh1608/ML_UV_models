@article{kumarRecentTrendsIcephobic2025,
	title = {Recent {Trends} in {Icephobic} {Polymer} {Coatings} for {Aerospace} {Applications} in {Cold} {Climates}},
	volume = {36},
	issn = {1099-1581},
	url = {https://onlinelibrary.wiley.com/doi/abs/10.1002/pat.70211},
	doi = {10.1002/pat.70211},
	abstract = {In cold climate conditions, the accumulation of ice on surfaces is a serious challenge for sectors like infrastructure, energy, transportation, and aviation. Recent advances in icephobic coatings are therefore addressed in this review paper, highlighting the materials' durability, efficiency, and design in harsh environments, as well as strategies to overcome the durability challenges. Icephobic coatings, such as superhydrophobic surfaces, SLIPS, and nanocomposite coatings, use low-surface-energy materials, surface chemistry, and micro/nanostructures to help prevent ice formation and attachment. Improvements in polymer coating, such as adding fluoropolymer-based coatings and graphene-reinforced composites, have increased ice resistance. But, still some issues remain, such as mechanical durability and long-term performance, particularly under cyclic icing and de-icing conditions. Environmental elements such as UV radiation and abrasion help to degrade coating efficacy. Research is focused on hybrid materials, cross-linked polymer networks, and responsive coatings that react to environmental stimuli. Computer modeling helps to optimize formulations and forecast actual performance. The future will seek sustainability, scalability, and multifunctionality by combining bio-inspired designs, adaptive materials, and sophisticated nanostructures. An interdisciplinary approach must be used to address the complexity of icephobic coatings for cold climates, which will motivate creativity in anti-icing technologies.},
	language = {en},
	number = {5},
	urldate = {2025-12-15},
	journal = {Polymers for Advanced Technologies},
	author = {Kumar, Rajat and Bhowmick, Hiralal and Sharma, Bikramjit},
	year = {2025},
	note = {\_eprint: https://onlinelibrary.wiley.com/doi/pdf/10.1002/pat.70211},
	keywords = {durability, icephobic coating, nanocomposite, polymer coating, superhydrophobic coating},
	pages = {e70211},
}

