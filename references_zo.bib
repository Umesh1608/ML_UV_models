@article{adlerSunscreenSafetyReview2020,
	title = {Sunscreen {Safety}: a {Review} of {Recent} {Studies} on {Humans} and the {Environment}},
	volume = {9},
	issn = {2162-4933},
	shorttitle = {Sunscreen {Safety}},
	url = {https://doi.org/10.1007/s13671-020-00284-4},
	doi = {10.1007/s13671-020-00284-4},
	abstract = {To provide an up-to-date synopsis of the literature on the safety of sunscreen active ingredients in humans and the environment and highlight regulatory changes in the USA.},
	language = {en},
	number = {1},
