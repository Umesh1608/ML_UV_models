@article{ghoshDeepLearningSpectroscopy2019,
  title = {Deep {{Learning Spectroscopy}}: {{Neural Networks}} for {{Molecular Excitation Spectra}}},
  shorttitle = {Deep {{Learning Spectroscopy}}},
  author = {Ghosh, Kunal and Stuke, Annika and Todorovi{\'c}, Milica and J{\o}rgensen, Peter Bj{\o}rn and Schmidt, Mikkel N. and Vehtari, Aki and Rinke, Patrick},
